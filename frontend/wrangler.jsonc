// Cloudflare Workers config: serves the Vite build as a static site.
{
  "name": "accountmap-demo",
  "compatibility_date": "2025-09-01",
  // Attaches the domain on deploy (creates the DNS record in the accountmap.org zone).
  "routes": [{ "pattern": "demo.accountmap.org", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    // Unknown paths like /about or /list fall back to index.html so React Router handles them.
    "not_found_handling": "single-page-application"
  }
}
